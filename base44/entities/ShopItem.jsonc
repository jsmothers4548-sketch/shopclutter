{
  "name": "ShopItem",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "stock_quantity": {
      "type": "number",
      "default": 0
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "reorder_threshold": {
      "type": "number",
      "default": 0
    },
    "for_sale": {
      "type": "boolean",
      "default": false
    },
    "sale_price": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "delete": {
      "data.shop_id": "{{user.data.shop_id}}"
    }
  }
}