{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "user",
        "owner",
        "system"
      ],
      "default": "user"
    },
    "sender_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}