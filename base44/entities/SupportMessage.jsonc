{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "user",
        "ai",
        "owner",
        "system"
      ],
      "default": "user"
    },
    "sender_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "action_json": {
      "type": "string"
    },
    "action_done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversation_id",
    "body"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}