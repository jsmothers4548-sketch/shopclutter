{
  "name": "Part",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_status": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "job_id",
    "name",
    "unit_cost"
  ],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.job_status": {
                "$ne": "Closed"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.job_status": {
                "$ne": "Closed"
              }
            }
          ]
        }
      ]
    }
  }
}