{
  "name": "PartPurchase",
  "type": "object",
  "properties": {
    "part_name": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "part_name",
    "supplier",
    "quantity",
    "unit_cost"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}