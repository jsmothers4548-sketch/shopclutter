{
  "name": "PartPurchase",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "part_name": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "part_name",
    "supplier",
    "quantity",
    "unit_cost"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}