{
  "name": "Reminder",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "appointment_type": {
      "type": "string",
      "enum": [
        "General",
        "On-site",
        "Off-site"
      ],
      "default": "General"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "due_date"
  ],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "delete": {
      "data.shop_id": "{{user.data.shop_id}}"
    }
  }
}