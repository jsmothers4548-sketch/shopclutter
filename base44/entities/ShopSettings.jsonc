{
  "name": "ShopSettings",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "on_site_rate": {
      "type": "number",
      "default": 40
    },
    "off_site_rate": {
      "type": "number",
      "default": 40
    },
    "service_call_fee": {
      "type": "number",
      "default": 80
    },
    "pickup_in_town": {
      "type": "number",
      "default": 40
    },
    "return_in_town": {
      "type": "number",
      "default": 40
    },
    "pickup_out_of_town": {
      "type": "number",
      "default": 50
    },
    "return_out_of_town": {
      "type": "number",
      "default": 75
    },
    "job_tax_rate": {
      "type": "number",
      "default": 9
    },
    "sales_tax_rate": {
      "type": "number",
      "default": 9
    },
    "overtime_rule": {
      "type": "string",
      "enum": [
        "federal",
        "daily"
      ],
      "default": "federal"
    },
    "allow_overlapping_job_timers": {
      "type": "boolean",
      "default": false
    },
    "late_fee_enabled": {
      "type": "boolean",
      "default": false
    },
    "late_fee_days": {
      "type": "number",
      "default": 30
    },
    "late_fee_type": {
      "type": "string",
      "enum": [
        "flat",
        "percentage"
      ],
      "default": "flat"
    },
    "late_fee_value": {
      "type": "number",
      "default": 0
    },
    "daily_fee_enabled": {
      "type": "boolean",
      "default": false
    },
    "daily_fee_type": {
      "type": "string",
      "enum": [
        "flat",
        "percentage"
      ],
      "default": "flat"
    },
    "daily_fee_value": {
      "type": "number",
      "default": 0
    },
    "brand_name": {
      "type": "string",
      "default": ""
    },
    "brand_tagline": {
      "type": "string",
      "default": ""
    },
    "brand_logo_url": {
      "type": "string",
      "default": ""
    },
    "brand_address": {
      "type": "string",
      "default": ""
    },
    "brand_phone": {
      "type": "string",
      "default": ""
    },
    "brand_email": {
      "type": "string",
      "default": ""
    },
    "highest_printed_label": {
      "type": "number",
      "default": 1000
    }
  },
  "required": [],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}