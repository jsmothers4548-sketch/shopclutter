{
  "name": "Sale",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "item_description": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "total_price": {
      "type": "number",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Paid"
      ],
      "default": "Open"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "item_description",
    "total_price"
  ],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "delete": {
      "data.shop_id": "{{user.data.shop_id}}"
    }
  }
}