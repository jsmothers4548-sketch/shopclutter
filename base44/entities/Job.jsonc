{
  "name": "Job",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "ticket_number": {
      "type": "string"
    },
    "job_location": {
      "type": "string",
      "enum": [
        "On-site",
        "Off-site"
      ],
      "default": "On-site"
    },
    "offsite_address": {
      "type": "string"
    },
    "service_call_fee": {
      "type": "number",
      "default": 0
    },
    "pickup_delivery_type": {
      "type": "string",
      "enum": [
        "None",
        "In-town",
        "Out-of-town"
      ],
      "default": "None"
    },
    "pickup_fee": {
      "type": "number",
      "default": 0
    },
    "return_fee": {
      "type": "number",
      "default": 0
    },
    "equipment_type": {
      "type": "string",
      "enum": [
        "Lawn Mower",
        "Motorcycle/ATV",
        "Generator",
        "Compressor",
        "Chainsaw",
        "Weed Eater",
        "Other"
      ]
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "problem_description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Intake",
        "Diagnosed",
        "Estimate Sent",
        "Approved",
        "In Progress",
        "Waiting on Parts",
        "Ready for Pickup",
        "Closed"
      ],
      "default": "Intake"
    },
    "tax_rate": {
      "type": "number",
      "default": 7
    },
    "default_labor_rate": {
      "type": "number",
      "default": 75
    },
    "parts_discount_type": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage"
      ],
      "default": "fixed"
    },
    "parts_discount_value": {
      "type": "number",
      "default": 0
    },
    "labor_discount_type": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage"
      ],
      "default": "fixed"
    },
    "labor_discount_value": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "customer_id",
    "customer_name",
    "equipment_type",
    "problem_description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.status": {
            "$ne": "Closed"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}