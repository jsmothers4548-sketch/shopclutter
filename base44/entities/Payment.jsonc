{
  "name": "Payment",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_status": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "Deposit",
        "Partial Payment",
        "Final Payment",
        "Other"
      ],
      "default": "Deposit"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string",
      "enum": [
        "Cash",
        "Card",
        "Check",
        "Other"
      ],
      "default": "Cash"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "amount"
  ],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.job_status": {
                "$ne": "Closed"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.job_status": {
                "$ne": "Closed"
              }
            }
          ]
        }
      ]
    }
  }
}