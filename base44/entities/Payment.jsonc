{
  "name": "Payment",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_status": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "Deposit",
        "Partial Payment",
        "Final Payment",
        "Other"
      ],
      "default": "Deposit"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string",
      "enum": [
        "Cash",
        "Card",
        "Check",
        "Other"
      ],
      "default": "Cash"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.job_status": {
            "$ne": "Closed"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.job_status": {
            "$ne": "Closed"
          }
        }
      ]
    }
  }
}