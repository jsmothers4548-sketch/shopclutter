{
  "name": "LaborEntry",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_status": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "hours": {
      "type": "number",
      "default": 0
    },
    "hourly_rate": {
      "type": "number",
      "default": 0
    },
    "pay_rate": {
      "type": "number",
      "default": 0
    },
    "technician": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "description",
    "hours",
    "hourly_rate"
  ],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.job_status": {
                "$ne": "Closed"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.job_status": {
                "$ne": "Closed"
              }
            }
          ]
        }
      ]
    }
  }
}