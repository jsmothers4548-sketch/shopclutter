{
  "name": "LaborEntry",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_status": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "hours": {
      "type": "number",
      "default": 0
    },
    "hourly_rate": {
      "type": "number",
      "default": 0
    },
    "pay_rate": {
      "type": "number",
      "default": 0
    },
    "technician": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "description",
    "hours",
    "hourly_rate"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.job_status": {
            "$ne": "Closed"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.job_status": {
            "$ne": "Closed"
          }
        }
      ]
    }
  }
}