{
  "name": "SaleItem",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "sale_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "shop_item_id": {
      "type": "string"
    }
  },
  "required": [
    "sale_id",
    "description",
    "unit_price"
  ],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "delete": {
      "data.shop_id": "{{user.data.shop_id}}"
    }
  }
}