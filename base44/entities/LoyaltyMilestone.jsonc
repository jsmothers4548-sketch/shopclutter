{
  "name": "LoyaltyMilestone",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "visit_count": {
      "type": "number",
      "default": 0
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "default": "percentage"
    },
    "discount_value": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "visit_count"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}