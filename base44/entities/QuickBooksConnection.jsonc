{
  "name": "QuickBooksConnection",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "disconnected",
        "connected",
        "error"
      ],
      "default": "disconnected"
    },
    "realm_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "sandbox"
      ],
      "default": "production"
    },
    "accounting_direction": {
      "type": "string",
      "enum": [
        "push",
        "pull",
        "two_way"
      ],
      "default": "two_way"
    },
    "payroll_enabled": {
      "type": "boolean",
      "default": false
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "pending_state": {
      "type": "string"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "shop_id"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}