{
  "name": "JobExpense",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_status": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "expense_date": {
      "type": "string",
      "format": "date"
    },
    "paid_by": {
      "type": "string"
    },
    "billable": {
      "type": "boolean",
      "default": true
    },
    "markup_percent": {
      "type": "number",
      "default": 0
    },
    "reimbursed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "job_id",
    "description",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.job_status": {
            "$ne": "Closed"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.job_status": {
            "$ne": "Closed"
          }
        }
      ]
    }
  }
}