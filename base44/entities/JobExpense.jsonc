{
  "name": "JobExpense",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_status": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "expense_date": {
      "type": "string",
      "format": "date"
    },
    "paid_by": {
      "type": "string"
    },
    "billable": {
      "type": "boolean",
      "default": true
    },
    "markup_percent": {
      "type": "number",
      "default": 0
    },
    "reimbursed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "job_id",
    "description",
    "amount"
  ],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.job_status": {
                "$ne": "Closed"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.job_status": {
                "$ne": "Closed"
              }
            }
          ]
        }
      ]
    }
  }
}