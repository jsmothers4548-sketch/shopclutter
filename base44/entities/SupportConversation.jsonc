{
  "name": "SupportConversation",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ],
      "default": "open"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_preview": {
      "type": "string"
    },
    "unread_for_owner": {
      "type": "boolean",
      "default": true
    },
    "unread_for_user": {
      "type": "boolean",
      "default": false
    },
    "screen_share_status": {
      "type": "string",
      "enum": [
        "none",
        "offered",
        "accepted",
        "declined"
      ],
      "default": "none"
    },
    "contact_shared": {
      "type": "boolean",
      "default": false
    },
    "session_status": {
      "type": "string",
      "enum": [
        "none",
        "requested",
        "scheduled"
      ],
      "default": "none"
    },
    "session_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_proposed_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_scheduled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "subject"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.shop_id": "{{user.data.shop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}