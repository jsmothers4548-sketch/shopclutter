{
  "name": "JobTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "equipment_type": {
      "type": "string",
      "enum": [
        "Lawn Mower",
        "Motorcycle/ATV",
        "Generator",
        "Compressor",
        "Chainsaw",
        "Weed Eater",
        "Other"
      ]
    },
    "problem_description": {
      "type": "string"
    },
    "tax_rate": {
      "type": "number",
      "default": 7
    },
    "default_labor_rate": {
      "type": "number",
      "default": 75
    },
    "parts_data": {
      "type": "string"
    },
    "labor_data": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}