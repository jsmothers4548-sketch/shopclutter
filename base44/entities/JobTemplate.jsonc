{
  "name": "JobTemplate",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "equipment_type": {
      "type": "string"
    },
    "problem_description": {
      "type": "string"
    },
    "tax_rate": {
      "type": "number",
      "default": 7
    },
    "default_labor_rate": {
      "type": "number",
      "default": 75
    },
    "flat_rate": {
      "type": "number",
      "default": 0
    },
    "parts_data": {
      "type": "string"
    },
    "labor_data": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "delete": {
      "data.shop_id": "{{user.data.shop_id}}"
    }
  }
}