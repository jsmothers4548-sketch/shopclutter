{
  "name": "Customer",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "read": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "create": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "update": {
      "data.shop_id": "{{user.data.shop_id}}"
    },
    "delete": {
      "data.shop_id": "{{user.data.shop_id}}"
    }
  }
}