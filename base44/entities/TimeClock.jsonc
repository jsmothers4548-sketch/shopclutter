{
  "name": "TimeClock",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "clock_in",
        "clock_out"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "shift_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "employee_id",
    "action",
    "timestamp"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}