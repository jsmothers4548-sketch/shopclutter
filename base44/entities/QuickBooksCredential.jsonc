{
  "name": "QuickBooksCredential",
  "type": "object",
  "properties": {
    "shop_id": {
      "type": "string"
    },
    "realm_id": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "sandbox"
      ],
      "default": "production"
    },
    "access_token": {
      "type": "string"
    },
    "refresh_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "refresh_expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "shop_id",
    "realm_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "service"
      }
    },
    "create": {
      "user_condition": {
        "role": "service"
      }
    },
    "update": {
      "user_condition": {
        "role": "service"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service"
      }
    }
  }
}